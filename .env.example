# Copy to .env and fill in. Never commit the real .env.

# SQLite database file (path is relative to prisma/schema.prisma).
# For PostgreSQL: postgresql://user:password@host:5432/motocodex
DATABASE_URL="file:./dev.db"

# Public site URL. Must be set at BUILD time so canonical / OG / sitemap URLs
# are baked correctly into statically rendered pages.
SITE_URL="http://localhost:9001"

# Cloudflare Tunnel credential used by the cloudflared service in docker-compose.
CLOUDFLARE_TUNNEL_TOKEN=""
